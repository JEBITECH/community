# ============================================================================
# COMMUNITY APP - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update values as needed
# cp .env.example .env

NODE_ENV=development

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=community_db
DB_USERNAME=community_user
DB_PASSWORD=change-me
ERP_DB_NAME=community_db

# ----------------------------------------------------------------------------
# Service Ports
# ----------------------------------------------------------------------------
PORT=4001
GATEWAY_PORT=4000
CLIENT_PORT=5174
NOTIFICATION_SERVICE_PORT=5011
ERP_NOTIFICATION_SERVICE_PORT=5011
PORT_TCP=6011
NOTIFICATION_MICROSERVICE_PORT=6011
ERP_NOTIFICATION_TCP_PORT=6011

# ----------------------------------------------------------------------------
# Service URLs
# ----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:4001
NOTIFICATION_SERVICE_URL=http://localhost:5011
NOTIFICATION_MICROSERVICE_HOST=localhost
COMMUNITY_SERVICE_URL=http://localhost:5021
COMMUNITY_SERVICE_PORT=5021

# ----------------------------------------------------------------------------
# Security — generate with: openssl rand -hex 32
# ----------------------------------------------------------------------------
USER_CONTEXT_SECRET=replace-with-64-char-hex-generated-by-openssl-rand-hex-32-value
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production-min-32-chars
JWT_RESET_SECRET=your-reset-secret-change-this-in-production-min-32-chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ----------------------------------------------------------------------------
# SMTP (Email Service)
# ----------------------------------------------------------------------------
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM=

# ----------------------------------------------------------------------------
# Links used in emails
# ----------------------------------------------------------------------------
INVITE_USER_LINK=http://localhost:5174/set-account-detail
RESET_PASSWORD_LINK=http://localhost:5174/reset-password
INVITE_TOKEN_EXPIRY_MINUTES=1440

# ----------------------------------------------------------------------------
# Redis (BullMQ / Queues)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api
# The client's live-chat Socket.io connection goes directly to community-svc,
# bypassing the gateway (WebSocket upgrades don't traverse the proxy
# cleanly) — so this needs to be community-svc's own public URL, not the
# gateway's. Baked in at build time, same as VITE_API_URL.
VITE_COMMUNITY_WS_URL=http://localhost:5021
