FROM node:20-alpine

RUN apk add --no-cache python3 make g++
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

WORKDIR /app

COPY package*.json ./
COPY server/platform/common ./server/platform/common/
COPY server/platform/shared-entities ./server/platform/shared-entities/
COPY server/services/notification-svc/package*.json ./server/services/notification-svc/

# --legacy-peer-deps: the workspace mixes @nestjs/swagger versions across services;
# matches the prod Dockerfiles which already use this flag.
RUN npm install --legacy-peer-deps

COPY server/services/notification-svc ./server/services/notification-svc/

RUN chown -R nodejs:nodejs /app

USER nodejs

WORKDIR /app/server/services/notification-svc

EXPOSE 5011 6011

CMD ["npm", "run", "dev"]
