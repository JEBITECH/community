{
  "name": "@community/auth-svc",
  "version": "1.0.0",
  "description": "RBAC/ACL + organization-management + baseline auth microservice for the Community app",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon",
    "dev:debug": "nodemon --exec \"ts-node --transpile-only --inspect\" src/index.ts",
    "dev-docker:debug": "nodemon --exec \"node --inspect=0.0.0.0:9229 -r ts-node/register src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:superadmin": "npx typeorm-ts-node-commonjs migration:create src/migrations/CreateDefaultAdminUser",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate src/migrations/Migration -d src/db.ts",
    "migration:seedmodules": "npx typeorm-ts-node-commonjs migration:create src/migrations/SeedModulesActionsSubactions",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d src/db.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d src/db.ts",
    "schema:sync": "npx typeorm-ts-node-commonjs schema:sync -d src/db.ts",
    "schema:drop": "npx typeorm-ts-node-commonjs schema:drop -d src/db.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/microservices": "^10.0.0",
    "@shared/common": "*",
    "@shared/entities": "*",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-validator-jsonschema": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-paginate": "^3.0.1",
    "nodemailer": "^7.0.6",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "routing-controllers-openapi": "^5.0.0",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.18",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.8.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "auth",
    "jwt",
    "microservice",
    "typescript",
    "express",
    "postgresql"
  ],
  "author": "Your Name",
  "license": "MIT"
}
