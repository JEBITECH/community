# Development Dockerfile for Auth Service with npm workspaces
FROM node:20-alpine

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Create app user for security
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

WORKDIR /app

# Copy workspace configuration first
COPY package*.json ./

# Copy shared packages
COPY server/platform/common ./server/platform/common/
COPY server/platform/shared-entities ./server/platform/shared-entities/

# Copy service package.json
COPY server/services/auth-svc/package*.json ./server/services/auth-svc/

# Copy service source code BEFORE installing (needed for workspace resolution)
COPY server/services/auth-svc ./server/services/auth-svc/

# Install ALL dependencies at root level (this creates workspace symlinks)
# --legacy-peer-deps: the workspace mixes @nestjs/swagger versions across services;
# matches the prod Dockerfiles which already use this flag.
RUN npm install --legacy-peer-deps

# Note: No build needed for development - services use ts-node

# Change ownership
RUN chown -R nodejs:nodejs /app

USER nodejs

WORKDIR /app/server/services/auth-svc

EXPOSE 4001

CMD ["npm", "run", "dev"]
